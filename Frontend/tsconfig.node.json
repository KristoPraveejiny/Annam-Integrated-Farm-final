{
  "compilerOptions": {
    "composite": true,
    // A referenced composite project may not disable emit, so send the output
    // somewhere harmless. Emitting in place produced a vite.config.js next to
    // vite.config.ts, and Vite loads the stale .js in preference to the .ts -
    // silently ignoring every later config change.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts"]
}